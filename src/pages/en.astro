---
import resume from "../../resume-en.json";
import "../styles/resume.css";

const { personal, experience, skills, portfolio } = resume;

const siteUrl = "https://monlouisj.github.io";
const pageUrl = `${siteUrl}/en`;
const description = `${personal.name}, ${personal.title}. ${experience.length} years of experience in web development — ${skills.development.slice(0, 4).join(", ")} and more.`;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{personal.name} — {personal.title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={pageUrl} />

		<!-- Open Graph -->
		<meta property="og:type" content="profile" />
		<meta
			property="og:title"
			content={`${personal.name} — ${personal.title}`}
		/>
		<meta property="og:description" content={description} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:locale" content="en_US" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary" />
		<meta
			name="twitter:title"
			content={`${personal.name} — ${personal.title}`}
		/>
		<meta name="twitter:description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,wght@6..144,1..1000&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<div class="page">
			<!-- HEADER -->
			<header class="header">
				<div class="header-main">
					<h1 class="name">{personal.name}</h1>
					<p class="title">{personal.title}</p>
				</div>
				<a href="/" class="lang-switch">FR</a>
				<div class="header-contact">
					<span class="contact-item">
						<svg
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							><path
								d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
							></path><circle cx="12" cy="10" r="3"></circle></svg
						>
						{personal.location}
					</span>
					<span class="contact-item">
						<svg
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							><path
								d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
							></path><polyline points="22,6 12,12 2,6"
							></polyline></svg
						>
						<a href={`mailto:${personal.email}`}>{personal.email}</a
						>
					</span>
					{
						personal.social?.github && (
							<span class="contact-item">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
								</svg>
								<a
									href={personal.social.github}
									target="_blank"
									rel="noopener"
								>
									GitHub
								</a>
							</span>
						)
					}
					{
						personal.social?.linkedin && (
							<span class="contact-item">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<>
										<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
										<rect
											x="2"
											y="9"
											width="4"
											height="12"
										/>
										<circle cx="4" cy="4" r="2" />
									</>
								</svg>
								<a
									href={personal.social.linkedin}
									target="_blank"
									rel="noopener"
								>
									LinkedIn
								</a>
							</span>
						)
					}
				</div>
			</header>

			<main class="main">
				<!-- EXPERIENCE -->
				<section id="experiences" class="section">
					<h2 class="section-title">Professional Experience</h2>
					<div class="timeline">
						{
							experience.map((job) => (
								<div class="timeline-item">
									<div class="timeline-meta">
										<span class="period">{job.period}</span>
									</div>
									<div class="timeline-content">
										<div class="job-header">
											<h3 class="job-title">
												{job.title}
											</h3>
											{job.company && (
												<span class="job-company">
													{job.company}
													{job.location && (
														<span class="job-location">
															{" "}
															— {job.location}
														</span>
													)}
												</span>
											)}
											{job.companies && (
												<span class="job-company">
													{job.companies.join(", ")}
												</span>
											)}
										</div>
										{job.projects &&
											job.projects.length > 0 && (
												<ul class="projects">
													{job.projects.map(
														(project) => (
															<li class="project">
																<span class="project-desc">
																	{
																		project.description
																	}
																</span>
																{"stack" in
																	project &&
																	project.stack && (
																		<div class="stack">
																			{(
																				project.stack as string[]
																			).map(
																				(
																					tech: string,
																				) => (
																					<span class="tag">
																						{
																							tech
																						}
																					</span>
																				),
																			)}
																		</div>
																	)}
															</li>
														),
													)}
												</ul>
											)}
									</div>
								</div>
							))
						}
					</div>
				</section>

				<div class="sidebar">
					<!-- SKILLS -->
					<section class="section">
						<h2 class="section-title">Skills</h2>
						<div class="skills-group">
							<h3 class="skills-label">Development</h3>
							<div class="skills-tags">
								{
									skills.development.map((s) => (
										<span class="tag tag--primary">
											{s}
										</span>
									))
								}
							</div>
						</div>
						<div class="skills-group">
							<h3 class="skills-label">Other</h3>
							<div class="skills-tags">
								{
									skills.other.map((s) => (
										<span class="tag">{s}</span>
									))
								}
							</div>
						</div>
					</section>

					<!-- PORTFOLIO -->
					<section id="portfolio" class="section">
						<h2 class="section-title">Portfolio</h2>
						<ul class="portfolio-list">
							{
								portfolio.map((item) => (
									<li class="portfolio-item">
										{item.period && (
											<span class="period">
												{item.period}
											</span>
										)}
										<h3>{item.name}</h3>
										<span class="project-desc">
											{item.description}
										</span>
										{item.url && (
											<a
												href={item.url}
												target="_blank"
												rel="noopener"
												class="portfolio-link"
											>
												{item.url}
											</a>
										)}
										{item.urls && (
											<div class="portfolio-urls">
												{item.urls.map((u) => {
													const isUrl =
														u.startsWith("http");
													return isUrl ? (
														<a
															href={u}
															target="_blank"
															rel="noopener"
															class="portfolio-link"
														>
															{u}
														</a>
													) : (
														<span class="portfolio-link">
															{u}
														</span>
													);
												})}
											</div>
										)}
									</li>
								))
							}
						</ul>
					</section>

					<!-- ARCTIC CODE VAULT -->
					<section id="mentions" class="section">
						<div class="badge-item">
							<img
								src="/arctic-code-vault-contributor-default-df8d74122a06.png"
								alt="Arctic Code Vault Contributor"
								class="badge-logo"
							/>
							<div class="badge-content">
								<h4 class="badge-title">
									Arctic Code Vault Contributor
								</h4>
								<p class="badge-desc">
									Contributed code to 2 repositories in the
									2020 GitHub Archive Program.
								</p>
								<a
									href="https://archiveprogram.github.com/"
									target="_blank"
									rel="noopener"
									class="portfolio-link"
									>archiveprogram.github.com</a
								>
							</div>
						</div>
					</section>

					<!-- Hubmonster 
					<section id="hubmonster" class="section">
						<div class="badge-item">
							<img
								src="/hubmonster-icon.svg"
								alt="Hubmonster"
								class="badge-logo"
							/>
							<div class="badge-content">
								<h4 class="badge-title">
									Hubmonster, Vice President
								</h4>
								<p class="badge-desc">
									Innovation promotion association
								</p>
								<a
									href="https://hubmonster.io/"
									target="_blank"
									rel="noopener"
									class="portfolio-link"
									>hubmonster.io</a
								>
							</div>
						</div>
					</section>-->
				</div>
			</main>
		</div>
	</body>
</html>
